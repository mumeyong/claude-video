#!/usr/bin/env bash
# MUMEYONG — one entry point, works from any folder (installed as `claude-video`).
#   claude-video                       list videos + status
#   claude-video "Judul video baru"    AUTOPILOT: new video from a title or idea number → Claude (headless) writes
#                                      idea + script + plan + scenes.py until check is clean → final render → hasil/
#   claude-video ideas                 list ideas not produced yet
#   claude-video new "Judul video"     only scaffold the folder (no Claude, no render)
#   claude-video <slug>                naskah → voice (recording, else TTS) → check → final render → hasil/<slug>/
#   claude-video <slug> preview        review round instead: cover → sheet → stills → 540p preview (optional)
#   claude-video open <slug>           open the video folder
#   claude-video <command> ...         any engine command — see `claude-video help`
export CV_CWD="$PWD"   # relative paths in arguments (--ref, ref <file>) are resolved from where you ran it
REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$REPO" || exit 1
PY="$REPO/.venv/bin/python"
[ -x "$PY" ] || { echo "venv missing: python3 -m venv --system-site-packages $REPO/.venv && $REPO/.venv/bin/pip install faster-whisper edge-tts"; exit 1; }

COMMANDS=" go auto new ideas estimate naskah align tts check still cover sheet critique preview render mix music sfx audition voices help ls list open export ref capture beats serve "

case "${1:-ls}" in
  ls|list)    exec "$PY" -m engine ls ;;
  help|-h|--help) exec "$PY" -m engine --help ;;
  open)       shift; xdg-open "$REPO/videos/${1:-}" >/dev/null 2>&1 & echo "$REPO/videos/${1:-}"; exit 0 ;;
esac

if [ -n "$1" ] && { [ -d "videos/$1" ] || compgen -G "videos/_*/$1/" >/dev/null; }; then
  slug=$1; shift
  # brief only (no scenes.py yet) → autopilot writes it first, then renders
  if [ -d "videos/$slug" ] && [ ! -f "videos/$slug/scenes.py" ]; then exec "$PY" -m engine auto "$slug" "$@"; fi
  exec "$PY" -m engine go "$slug" "$@"
fi

if [[ "$COMMANDS" != *" $1 "* ]]; then
  # not a command, not an existing video → autopilot: new video from this title / idea number, then render
  exec "$PY" -m engine auto "$@"
fi

exec "$PY" -m engine "$@"
